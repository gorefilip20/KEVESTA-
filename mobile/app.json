{
  "expo": {
    "name": "KEVESTA",
    "slug": "kevesta",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kevesta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kevesta.app"
    },
    "android": {
      "package": "com.kevesta.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-font"
    ]
  }
}
