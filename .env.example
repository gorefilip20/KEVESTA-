# ============================================
# KEVESTA Environment Configuration
# Copy to .env.local and fill in your values
# ============================================

# --- Payments: Column bank infrastructure ---
# Keep these server-only. Never prefix them with NEXT_PUBLIC_ or expose them to the browser.
COLUMN_API_KEY=
COLUMN_API_BASE=https://api.column.com
# Set this to the exact transfer endpoint enabled for your Column tenant.
COLUMN_ACH_TRANSFER_PATH=/v1/ach/transfers
COLUMN_WEBHOOK_SECRET=
# Used to sign short-lived crypto quotes. Use a random secret in production.
CRYPTO_QUOTE_SECRET=
CRYPTO_QUOTE_TTL_SECONDS=120
# Destination account configured in your Column tenant.
COLUMN_RECEIVING_ACCOUNT_ID=

# Public application URL used for callbacks and CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Web3 / Wallet Integration ---
# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: custom RPC endpoints (public fallbacks are used if empty)
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_BSC=

# Merchant wallet address to receive crypto payments
NEXT_PUBLIC_MERCHANT_WALLET=

# --- Flight Search (Amadeus API) ---
# Get credentials at https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# --- Accommodation Search (RapidAPI / Booking.com) ---
# Get a key at https://rapidapi.com
RAPIDAPI_KEY=

NODE_ENV=development
